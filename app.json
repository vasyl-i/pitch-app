{
  "expo": {
    "name": "PitchGym",
    "slug": "pitchgym",
    "version": "1.3.9",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#101113",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#08070C"
    },
    "ios": {
      "icon": "./Icons.icon",
      "appleTeamId": "4F6C4GS493",
      "supportsTablet": false,
      "bundleIdentifier": "app.anya.eargym",
      "googleServicesFile": "./assets/GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationCategoryType": "public.app-category.music",
        "CFBundleDisplayName": "PitchGym",
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "app.anya.eargym",
      "adaptiveIcon": {
        "backgroundColor": "#7C92F9",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "splash": {
        "image": "./assets/splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#08070C"
      },
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./assets/google-services.json",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "scheme": "app.anya.eargym",
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      [
        "react-native-audio-api",
        {
          "iosMicrophonePermission": "PitchGym listens while you sing to show you the note you are hitting. Audio never leaves your device.",
          "iosBackgroundMode": false,
          "androidPermissions": [
            "android.permission.RECORD_AUDIO"
          ],
          "androidForegroundService": false
        }
      ],
      "./plugins/with-spaces-in-path-fix",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.937030610704-j994i9qmsootnnltkps2pudvtc6iuqcn"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Satoshi-Regular.ttf",
            "./assets/fonts/Satoshi-Medium.ttf",
            "./assets/fonts/Satoshi-Bold.ttf",
            "./assets/fonts/Satoshi-Black.ttf",
            "./assets/fonts/Manrope-Regular.ttf",
            "./assets/fonts/Manrope-Medium.ttf",
            "./assets/fonts/Manrope-Bold.ttf",
            "./assets/fonts/Manrope-ExtraBold.ttf"
          ]
        }
      ],
      "./plugins/with-liquid-glass-icon-fix",
      "./plugins/with-splash-cover",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#7C92F9"
        }
      ],
      "@react-native-community/datetimepicker",
      "@react-native-firebase/app",
      "@react-native-firebase/crashlytics",
      "./plugins/with-firebase-disable-spm",
      "./plugins/with-gradle-memory",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.swmansion.audioapi.** { *; }\n-keep class com.shopify.reactnative.skia.** { *; }"
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": [
            "en",
            "uk",
            "pt-PT"
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "8f6ed2ac-0df9-4205-bb4b-91610b1ece8e"
      }
    },
    "owner": "i_vasyl",
    "locales": {
      "en": "./assets/locales/en.json",
      "uk": "./assets/locales/uk.json",
      "pt-PT": "./assets/locales/pt.json"
    }
  }
}
