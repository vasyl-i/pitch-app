# Benchmark corpus audio is tracked with Git LFS; the annotations and metadata
# beside it are ordinary text and stay in the main repository, so a recording's
# reference annotation remains readable and diffable in a normal clone.
#
# IMPORTANT: run `git lfs install` and confirm `git lfs track` reports these
# patterns BEFORE committing any audio. LFS does not retroactively capture files
# already written to history — that needs `git lfs migrate`, which rewrites
# commits.
benchmark-corpus/**/*.wav filter=lfs diff=lfs merge=lfs -text
benchmark-corpus/**/*.flac filter=lfs diff=lfs merge=lfs -text

# Annotations, metadata and protocol docs are deliberately NOT in LFS.
benchmark-corpus/**/*.json -filter -diff -merge text
benchmark-corpus/**/*.md -filter -diff -merge text
